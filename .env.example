# Copy to .env.local and add your TinyFish API key (get one at https://agent.tinyfish.ai/api-keys)
# Without a key, Funding Radar runs in clearly-labelled DEMO mode with three full preset results.
TINYFISH_API_KEY=
# Optional: set to "false" to skip the (metered) TinyFish Agent verification pass in live mode.
TINYFISH_ENABLE_AGENT=true
# Note: live mode also creates a TinySet dataset per search (Datasets API).
# TinySet charges $0.10 per row from the TinyFish wallet; Radar requests 15 rows (~$1.50/search).
